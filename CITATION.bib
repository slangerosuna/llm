@article{qwen3embedding,
  title = {Qwen3 Embedding: Advancing Text Embedding and Reranking Through
           Foundation Models},
  author = {Zhang, Yanzhao and Li, Mingxin and Long, Dingkun and Zhang, Xin and
            Lin, Huan and Yang, Baosong and Xie, Pengjun and Yang, An and Liu,
            Dayiheng and Lin, Junyang and Huang, Fei and Zhou, Jingren},
  journal = {arXiv preprint arXiv:2506.05176},
  year = {2025},
  annote = {Used the Qwen3-Embedding-4B model to generate training data for KRV
            generation. Because I am training my model to generate the embeddings
            that the Qwen3-Embedding-4B model generates, I am performing a form
            of knowledge distillation. Hypothetically, my model could be trained
            by using *any* embedding model to generate training data, and, since
            it is itself an SLM and all SLMs can be adapted to be embedding
            models, the training process could be entirely self-contained.
            However, this would require substantially more dev time and
            computational resources, so I opted to use an existing embedding
            model to generate training data which has the added positive side
            effect of grounding my model in a decently well understood embedding
            space, allowing me to leverage Qwen3-Embedding-4B to generate
            ontologies, and the aforementioned KD.},
}

